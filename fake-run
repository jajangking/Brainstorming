#!/data/data/com.termux/files/usr/bin/bash
# fake-run — runner UNIVERSAL wadah palsu (fakechroot) tanpa root, tanpa proot.
#
#   fake-run [--svsp] [--loader=FILE] [--shim=FILE] [--base=DIR] [ENV=val ...] <program> [args...]
#
# Dua jalur, otomatis dipilih berdasar jenis binary:
#   - DINAMIS (punya PT_INTERP)  -> jalur cepat: loader musl patched (seccomp-safe)
#                                   + LD_PRELOAD libfakeroot.so (rewrite path).
#   - STATIS (tanpa PT_INTERP)   -> LD_PRELOAD TIDAK berlaku -> otomatis pakai
#                                   supervisor seccomp USER_NOTIF (svsp):
#                                   filter kernel tambahan, parent bebas-filter
#                                   me-rewrite path di level syscall.
#   - --svsp                     -> paksa pakai supervisor untuk apa pun.
#
# Isolasi path: absolut -> FAKE_BASE+path; /dev /proc /sys passthrough.
# set*id tetap dinetralkan oleh shim SIGSYS (libfakeroot.so) pada kedua jalur.

set -euo pipefail

HOME_BASE="${FAKE_BASE:-$HOME/alpine-rootfs}"
SHIM="${FAKE_SHIM:-$HOME/libfakeroot.so}"
LOADER="${FAKE_LOADER:-$HOME/alpine-rootfs/lib/ld-musl-patched.so.1}"
SVSP="${FAKE_SVSP:-}"
MODE=auto

# opsi --loader/--shim/--base/--svsp dan ENV=val di depan
extra_env=()
while [ $# -gt 0 ]; do
    case "$1" in
        --loader=*) LOADER="${1#--loader=}"; shift ;;
        --shim=*)   SHIM="${1#--shim=}"; shift ;;
        --base=*)   HOME_BASE="${1#--base=}"; shift ;;
        --svsp)     MODE=svsp; shift ;;
        --ldpreload) MODE=ldpreload; shift ;;
        *=*)        extra_env+=("$1"); shift ;;
        *)          break ;;
    esac
done

[ $# -ge 1 ] || { echo "pemakaian: fake-run [--svsp] [--loader=FILE] [ENV=val ...] <program> [args...]"; exit 2; }
prog="$1"; shift

# resolve program
case "$prog" in
    /data/*|/dev/*|/proc/*|/sys/*|/apex/*|/system/*)
        host="$prog" ;;
    /*)
        host="$HOME_BASE$prog" ;;
    *)
        host=""
        for d in /bin /usr/bin /sbin /usr/sbin /usr/local/bin /usr/local/sbin; do
            if [ -e "$HOME_BASE$d/$prog" ]; then host="$HOME_BASE$d/$prog"; break; fi
        done
        if [ -z "$host" ] && [ -e "$(pwd -P)/$prog" ]; then host="$(pwd -P)/$prog"; fi
        [ -n "$host" ] || host="$prog"
        ;;
esac
[ -e "$host" ] || { echo "fake-run: program tak ada: $host"; exit 1; }

# deteksi ELF dinamis: ada PT_INTERP? (readelf bila ada; fallback od portabel)
is_dynamic() {
    local f="$1"
    if command -v readelf >/dev/null 2>&1; then
        # JANGAN pakai grep -q di pipeline ber-set -o pipefail: grep -q keluar begitu
        # cocok -> readelf kena SIGPIPE (rc 141) -> is_dynamic salah-klasifikasi
        # dinamis->statis -> MODE=svsp -> boot tanpa shim -> "not found" (flake ~0-25%).
        # grep biasa (tanpa -q) membaca semua input -> readelf selesai normal.
        readelf -l "$f" 2>/dev/null | grep 'Requesting program interpreter' >/dev/null
        return $?
    fi
    # parse program-header ELF64 murni (tanpa dependensi)
    local hdr=( $(od -An -t u1 -N64 "$f" 2>/dev/null) )
    [ ${#hdr[@]} -ge 58 ] || return 1
    local phoff=0 phesz phnum i j t off
    for i in 32 33 34 35 36 37 38 39; do
        phoff=$(( phoff + (${hdr[$i]} << (8*(i-32))) ))
    done
    phesz=$(( ${hdr[54]} + (${hdr[55]} << 8) ))
    phnum=$(( ${hdr[56]} + (${hdr[57]} << 8) ))
    for i in $(seq 0 $((phnum - 1))); do
        off=$((phoff + i * phesz))
        local ph=( $(od -An -t u1 -j "$off" -N "$phesz" "$f" 2>/dev/null) )
        [ ${#ph[@]} -ge 4 ] || return 1
        t=$(( ${ph[0]} + (${ph[1]} << 8) + (${ph[2]} << 16) + (${ph[3]} << 24) ))
        [ "$t" -eq 3 ] && return 0      # PT_INTERP
    done
    return 1
}

if [ "$MODE" = auto ]; then
    if is_dynamic "$host"; then MODE=ldpreload; else MODE=svsp; fi
fi

mkdir -p "$HOME_BASE/root" "$HOME_BASE/tmp" || true

cd "$HOME_BASE"

if [ "$MODE" = svsp ]; then
    # ===== jalur supervisor USER_NOTIF (statis / --svsp) =====
    [ -n "$SVSP" ] || for d in "$(dirname "$0")" "$HOME" "$HOME/Brainstorming" "$PREFIX/bin"; do
        [ -x "$d/svsp" ] && { SVSP="$d/svsp"; break; }
    done
    [ -n "$SVSP" ] || { echo "fake-run: svsp tak ada. Bangun dulu: clang -O2 -o svsp svsp.c"; exit 1; }
    [ -x "$SVSP" ] || { echo "fake-run: svsp tak dapat dieksekusi: $SVSP"; exit 1; }
    exec env -i \
      FAKE_BASE="$HOME_BASE" \
      PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
      LD_LIBRARY_PATH="$HOME_BASE/lib:$HOME_BASE/usr/lib" \
      HOME="$HOME_BASE/root" \
      TMPDIR="$HOME_BASE/tmp" \
      PWD="$HOME_BASE" \
      USER=root LOGNAME=root SHELL=/bin/sh \
      TERM="${TERM:-xterm-256color}" \
      ${extra_env[@]+"${extra_env[@]}"} \
      "$SVSP" --base="$HOME_BASE" "$host" "$@"
fi

# ===== jalur cepat LD_PRELOAD (binary dinamis) =====
[ -e "$SHIM" ] || { echo "fake-run: shim tak ada: $SHIM"; exit 1; }
[ -x "$LOADER" ] || { echo "fake-run: loader tak ada: $LOADER"; exit 1; }

exec env -i \
  LD_PRELOAD="$SHIM" \
  FAKE_BASE="$HOME_BASE" \
  PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
  LD_LIBRARY_PATH="$HOME_BASE/lib:$HOME_BASE/usr/lib" \
  HOME="$HOME_BASE/root" \
  TMPDIR="$HOME_BASE/tmp" \
  PWD="$HOME_BASE" \
  USER=root LOGNAME=root SHELL=/bin/sh \
  TERM="${TERM:-xterm-256color}" \
  ${extra_env[@]+"${extra_env[@]}"} \
  "$LOADER" "$host" "$@"