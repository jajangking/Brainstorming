#!/data/data/com.termux/files/usr/bin/bash
# selftest — verifikasi SATU PERINTAH wadah alpine (shim + svsp + apk-doctor).
#
#   ./selftest                    # uji lengkap (butuh jaringan utk apk add)
#   ./selftest --diagnose         # read-only: artefak + DB + resolv.conf saja
#   SELFTEST_PKG=acl ./selftest   # ganti paket uji (default: acl)
#
# Output: baris [PASS]/[FAIL] + ringkasan; exit code = jumlah FAIL.
# Simpan hasil utk feedback:
#   ./selftest | tee device-feedback/selftest-$(date +%F).txt
#
# Strategi (HANDOFF §21): jalur utama apk = SHIM (`fake-run apk`, TANPA
# --svsp) — terbukti hijau penuh di device. Bagian svsp di sini memverifikasi
# jalur alternatif; kegagalannya TIDAK menghalangi pemakaian harian wadah.

set -u

PKG="${SELFTEST_PKG:-acl}"
BASE="${FAKE_BASE:-$HOME/alpine-rootfs}"
MODE=full
[ "${1:-}" = "--diagnose" ] && MODE=diag

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
FR="$(command -v fake-run || echo "$SELF_DIR/fake-run")"
DOC="$(command -v apk-doctor || echo "$SELF_DIR/apk-doctor")"
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

TMPF="$(mktemp "${TMPDIR:-$PREFIX/tmp}/.doctor.XXXXXX" 2>/dev/null || echo "$BASE/tmp/.doctor-pre.$$")"

FAILS=0
pass() { printf '[PASS] %s\n' "$1"; }
fail() { printf '[FAIL] %s — %s\n' "$1" "$2"; FAILS=$((FAILS + 1)); }
info() { printf '[info] %s\n' "$1"; }
chk()  { if [ "$2" -eq 0 ]; then pass "$1"; else fail "$1" "$3"; fi; }

echo "== selftest $(date '+%F %T') mode=$MODE base=$BASE =="

# --- 1. artefak -------------------------------------------------------------
chk "ada: $FR" "$([ -e "$FR" ]; echo $?)" "file tak ditemukan"
chk "ada: $DOC" "$([ -e "$DOC" ]; echo $?)" "file tak ditemukan"
chk "base ada: $BASE" "$([ -d "$BASE" ]; echo $?)" "jalankan bootstrap.sh dulu"
chk "shim libfakeroot.so" "$([ -e "${FAKE_SHIM:-$HOME/libfakeroot.so}" ] || [ -e "$SELF_DIR/libfakeroot.so" ]; echo $?)" "jalankan install.sh dulu"
chk "svsp" "$([ -x "${FAKE_SVSP:-$PREFIX/bin/svsp}" ] || [ -x "$SELF_DIR/svsp" ] || [ -x "$HOME/svsp" ]; echo $?)" "jalankan install.sh dulu"
chk "loader patched" "$([ -e "$BASE/lib/ld-musl-patched.so.1" ]; echo $?)" "jalankan install.sh dulu"

# --- 2. resolv.conf ---------------------------------------------------------
if [ -f "$BASE/etc/resolv.conf" ]; then
    NS=$(grep -c '^nameserver' "$BASE/etc/resolv.conf")
    chk "resolv.conf >=2 NS (dapat $NS)" "$([ "$NS" -ge 2 ]; echo $?)" "setup_dns bermasalah"
    if grep -q '^options' "$BASE/etc/resolv.conf"; then
        pass "resolv.conf ada baris options"
    else
        fail "resolv.conf options" "baris options hilang"
    fi
else
    fail "resolv.conf" "$BASE/etc/resolv.conf tak ada"
fi

# --- 3. apk-doctor ----------------------------------------------------------
if bash "$DOC" --base="$BASE" >"$TMPF" 2>&1; then
    pass "apk-doctor: DB bersih (tanpa flag f/s)"
else
    fail "apk-doctor: ada flag f/s basi" "$(grep -m3 '  ' "$TMPF" 2>/dev/null | tr '\n' ';')"
fi

if [ "$MODE" = diag ]; then
    echo "== diagnose selesai: $FAILS FAIL =="
    exit "$FAILS"
fi

# --- 4. baseline: bersihkan flag basi agar test tak saling mencemari --------
bash "$DOC" --base="$BASE" --clear-broken >/dev/null 2>&1
info "baseline: flag f/s dibersihkan dulu (backup .bak-doctor.* disimpan apk-doctor)"

# --- 5. jalur SHIM (JALUR UTAMA — §21) --------------------------------------
OUT=$(bash "$FR" apk --version 2>&1); RC=$?
if [ $RC -eq 0 ] && printf '%s' "$OUT" | grep -q 'apk-tools'; then
    pass "shim: apk --version"
else
    fail "shim: apk --version" "rc=$RC out=$(printf '%s' "$OUT" | head -1)"
fi

info "shim: apk add --no-cache $PKG ..."
OUT=$(bash "$FR" apk add --no-cache "$PKG" 2>&1); RC=$?
chk "shim: apk add $PKG rc=0" "$([ $RC -eq 0 ]; echo $?)" "rc=$RC out=$(printf '%s' "$OUT" | tail -2 | tr '\n' ' ')"
if printf '%s' "$OUT" | grep -qi 'error'; then
    fail "shim: apk add tanpa baris error" "$(printf '%s' "$OUT" | grep -i error | head -2 | tr '\n' ' ')"
else
    pass "shim: apk add tanpa baris error"
fi

OUT=$(bash "$FR" apk add busybox 2>&1); RC=$?   # paket dengan trigger
chk "shim: apk add busybox (trigger) rc=0" "$([ $RC -eq 0 ]; echo $?)" "rc=$RC out=$(printf '%s' "$OUT" | tail -2 | tr '\n' ' ')"

# --- 6. jalur SVSP (alternatif) ----------------------------------------------
# device-feedback ronde 3 butir 2b: tanpa purge, step ini no-op (paket sudah
# terpasang oleh step shim) -> kriteria svsp vakum. Purge dulu agar nyata.
info "purge $PKG agar transaksi svsp nyata ..."
bash "$FR" apk del --no-scripts "$PKG" >/dev/null 2>&1
info "svsp: apk add --no-cache $PKG ..."
OUT=$(bash "$FR" --svsp apk add --no-cache "$PKG" 2>&1); RC=$?
chk "svsp: apk add $PKG rc=0" "$([ $RC -eq 0 ]; echo $?)" "rc=$RC out=$(printf '%s' "$OUT" | tail -3 | tr '\n' ' ')"
if printf '%s' "$OUT" | grep -qi 'failed to write database'; then
    fail "svsp: tanpa 'failed to write database'" "DB write gagal (bug §17.2 kambuh)"
else
    pass "svsp: tanpa 'failed to write database'"
fi
if printf '%s' "$OUT" | grep -qi 'not an absolute path'; then
    fail "svsp: tanpa 'not an absolute path'" "busybox --install gagal (bug ronde-2 kambuh)"
else
    pass "svsp: tanpa 'not an absolute path'"
fi
if printf '%s' "$OUT" | grep -qi 'error'; then
    fail "svsp: tanpa baris error lain" "$(printf '%s' "$OUT" | grep -i error | head -2 | tr '\n' ' ')"
else
    pass "svsp: tanpa baris error lain"
fi
LEFT="$(ls -A "$BASE/lib/apk/exec" 2>/dev/null)"
chk "svsp: lib/apk/exec kosong" "$([ -z "$LEFT" ]; echo $?)" "sisa: $(printf '%s' "$LEFT" | tr '\n' ' ')"

# --- 7. uji kecil lain -------------------------------------------------------
OUT=$(bash "$FR" /bin/busybox sh -c 'echo SBARGS-ok' 2>&1)
chk "fake-run SBARGS (busybox sh -c)" "$(printf '%s' "$OUT" | grep -q 'SBARGS-ok'; echo $?)" "out=$(printf '%s' "$OUT" | head -1)"

bash "$FR" /bin/busybox test -e /data/data/com.termux/files/home >/dev/null 2>&1; RC=$?
chk "shim: /data passthrough" "$([ $RC -eq 0 ]; echo $?)" "rc=$RC (HANDOFF §20.2)"

# --- 8. MATRIX REGRESI §40-§45 (ronde 19, device 2026-10-08) -------------------
# Empat bug yang ditemukan saat memasang Hermes Agent di wadah. Semuanya kini
# ter-fix; test ini menjaga agar perubahan shim/svsp/fake-run masa depan tak
# membatalkannya. Gagal di sini = regresi nyata, bukan masalah lingkungan.
info "=== matrix regresi §40-§56 ==="

# §40 supervised dynamic harus memuat shim; tanpa itu `bash` di supervisor mati
# SIGSYS (trap faccessat2/faccessat yang tiba SEBELUM notif svsp).
OUT=$(bash "$FR" --svsp bash -c 'uname -s' 2>&1); RC=$?
if [ $RC -eq 0 ] && printf '%s' "$OUT" | grep -q 'Linux'; then
    pass "§40 svsp+bash: uname -s = Linux (tanpa SIGSYS)"
else
    fail "§40 svsp+bash: uname -s" "rc=$RC out=$(printf '%s' "$OUT" | head -1)"
fi
OUT=$(bash "$FR" --svsp bash -c 'test -x /bin/ls && echo XOK' 2>&1); RC=$?
chk "§40 svsp+bash: PATH-lookup test -x" "$(printf '%s' "$OUT" | grep -q XOK; echo $?)" "out=$(printf '%s' "$OUT" | head -1)"

# §42 Node/Bun memanggil io_uring_setup yang di-trap Android; ENOSYS membuat
# libuv menutup ringfd tak-invalid lalu abort. Shim harus jawab fd /dev/null.
# (Hanya dicek bila ada biner node di wadah — tidak dipasang default.)
NODEBIN="$( { find "$BASE/root" -type f -name node -path '*node*/bin/node' 2>/dev/null; \
               find "$BASE" -maxdepth 4 -type f -name node -path '*/bin/node' 2>/dev/null; \
               find "$BASE" -maxdepth 3 -type f -name node 2>/dev/null; } | head -1)"
if [ -n "$NODEBIN" ]; then
    OUT=$(bash "$FR" "$NODEBIN" -e 'console.log("SELFTEST-NODE-OK")' 2>&1); RC=$?
    chk "§42 node -e (io_uring guard)" "$(printf '%s' "$OUT" | grep -q 'SELFTEST-NODE-OK'; echo $?)" "out=$(printf '%s' "$OUT" | tail -1)"
else
    info "§42 dilewati: biner 'node' tak ada di wadah"
fi

# §44 syscall dua-path (rename/link) tidak boleh me-rewrite path RELATIF jadi
# $BASE+rel (tanpa separator) -> ENOENT. Pola setuptools egg-info.
OUT=$(bash "$FR" --svsp bash -c 'mkdir -p /tmp/.st44/sub && echo hi > /tmp/.st44/a && mv /tmp/.st44/a /tmp/.st44/sub/b && cat /tmp/.st44/sub/b' 2>&1); RC=$?
chk "§44 rename abs->rel" "$(printf '%s' "$OUT" | grep -q '^hi$'; echo $?)" "out=$(printf '%s' "$OUT" | tail -1)"
rm -rf "$BASE/tmp/.st44" 2>/dev/null

# §43 binary ber-INTERP-stock yang di-exec dari parent statis harus di-redirect
# supervisor lewat wrapper ~/.svsp-elfwrap (tak boleh ENOENT). Dipakai binary
# dummy yang INTERP-nya sengaja dikembalikan ke loader stock.
# CATATAN: salinan HARUS tetap bernama 'busybox' di direktinya sendiri — busybox
# memakai argv[0] sebagai pemilih applet, jadi 'nama-lain' -> "applet not found".
STOCKDIR="$BASE/tmp/.selftest-stock"
mkdir -p "$STOCKDIR" 2>/dev/null
cp "$BASE/bin/busybox" "$STOCKDIR/busybox" 2>/dev/null && chmod +x "$STOCKDIR/busybox" 2>/dev/null
STOCKBIN="$STOCKDIR/busybox"
if [ -x "$STOCKBIN" ] && command -v patchelf >/dev/null 2>&1; then
    patchelf --set-interpreter /lib/ld-musl-aarch64.so.1 "$STOCKBIN" 2>/dev/null
    OUT=$(bash "$FR" --svsp "$STOCKBIN" echo SELFTEST-43-OK 2>&1); RC=$?
    chk "§43 ELF INTERP-stock via svsp" "$(printf '%s' "$OUT" | grep -q 'SELFTEST-43-OK'; echo $?)" "rc=$RC out=$(printf '%s' "$OUT" | tail -1)"
    rm -rf "$STOCKDIR"
else
    info "§43 dilewati: busybox/patchelf tak tersedia untuk binary uji"
    rm -rf "$STOCKDIR" 2>/dev/null
fi

# §45 svsp tidak boleh membuang LD_LIBRARY_PATH (biner glibc butuh path custom;
# regresi bila suatu saat ada yang meng-unset-nya lagi).
SVSP_SRC="$SELF_DIR/svsp.c"
if [ -f "$SVSP_SRC" ]; then
    if grep -q 'unsetenv("LD_LIBRARY_PATH")' "$SVSP_SRC"; then
        fail "§45 svsp tidak unset LD_LIBRARY_PATH" "unsetenv LD_LIBRARY_PATH ada lagi di svsp.c"
    else
        pass "§45 svsp tidak unset LD_LIBRARY_PATH"
    fi
else
    info "§45 dilewati: svsp.c tak ditemukan di $SELF_DIR"
fi

# §47 path HOST yang bocor keluar dari container tidak boleh di-rewrite.
# "/data/" sudah passthrough sejak §20, tapi "/data" (tanpa garis miring)
# TIDAK -> jadi $BASE/data -> ENOENT. Node memanggil lstat("/data") sebagai
# komponen pertama fs.realpathSync, sehingga `npm install -g <paket>`
# mati "ENOENT lstat '/data'" (device 2026-10-09).
OUT=$(bash "$FR" --svsp sh -c 'test -d /data && echo DATA-PASSTHROUGH-OK' 2>&1); RC=$?
chk "§47 svsp: /data (tanpa slash) passthrough" "$(printf '%s' "$OUT" | grep -q 'DATA-PASSTHROUGH-OK'; echo $?)" "out=$(printf '%s' "$OUT" | tail -1)"

NODEBIN2="$(find "$BASE" -maxdepth 5 -type f -name node 2>/dev/null | head -1)"
if [ -n "$NODEBIN2" ]; then
    OUT=$(bash "$FR" --svsp "$NODEBIN2" -e 'require("fs").realpathSync("/data");console.log("SELFTEST-47-OK")' 2>&1); RC=$?
    chk "§47 node realpathSync('/data')" "$(printf '%s' "$OUT" | grep -q 'SELFTEST-47-OK'; echo $?)" "out=$(printf '%s' "$OUT" | tail -1)"

    # §48 runtime syscall mentah (Node via libuv) tak bisa di-interpose shim
    # LD_PRELOAD; harus lewat supervisor. Yang diuji di sini mode auto fake-run
    # memilih svsp untuk nama runtime tersebut.
    if bash "$FR" "$NODEBIN2" -e 'require("fs").realpathSync(process.cwd());console.log("SELFTEST-46-OK")' >/dev/null 2>&1 ||
       bash "$FR" --svsp "$NODEBIN2" -e 'require("fs").realpathSync(process.cwd())' >/dev/null 2>&1; then
        pass "§48 node nyata (auto/svsp) bisa realpath host"
    else
        fail "§48 node nyata (auto/svsp) bisa realpath host" "node gagal realpathSync di dalam wadah"
    fi
else
    info "§48/§47 dilewati sebagian: biner 'node' tak ada di wadah"
fi

# §48 fake-run + alpine wajib memilih supervisor untuk runtime raw-syscall.
if [ -f "$SELF_DIR/fake-run" ] && grep -qF 'node[0-9]*' "$SELF_DIR/fake-run"; then
    pass "§48 fake-run: runtime raw-syscall dipaksa MODE=svsp"
else
    fail "§48 fake-run: runtime raw-syscall dipaksa MODE=svsp" "daftar node/bun/deno tak ada di fake-run"
fi
if [ -f "$SELF_DIR/alpine" ] && grep -qF -- '--svsp --base=' "$SELF_DIR/alpine"; then
    pass "§48 alpine: shell wadah lewat --svsp"
else
    fail "§48 alpine: shell wadah lewat --svsp" "alpine tak memanggil fake-run --svsp"
fi

# §50 $PWD harus path WADAH ("/" atau "/root"), bukan path host panjang.
# Dua lapis wajib benar: PWD di env child, DAN kernel cwd konsisten (shell
# membandingkan $PWD vs device+inode cwd; kalau beda, ash/bash jatuh ke
# getcwd() dan path host muncul lagi).
OUT=$(bash "$FR" --svsp sh -c 'printf "%s" "$PWD"' 2>&1)
if [ "$OUT" = "/" ]; then
    pass "§50 svsp: PWD = / (bukan path host)"
else
    fail "§50 svsp: PWD = / (bukan path host)" "PWD=$OUT"
fi
OUT=$(FAKE_START="$BASE/root" bash "$FR" --svsp sh -c 'printf "%s|%s" "$PWD" "$(test -d .npm && echo ada || echo tak)"' 2>&1)
case "$OUT" in
    /root\|ada) pass "§50 svsp: FAKE_START=/root -> PWD=/root + cwd benar" ;;
    *)          fail "§50 svsp: FAKE_START=/root -> PWD=/root + cwd benar" "out=$OUT" ;;
esac
# cd relatif masih harus mengenai file yang benar setelah PWD diterjemahkan.
OUT=$(bash "$FR" --svsp sh -c 'cd /usr && test -x bin/node && printf ok' 2>&1)
if [ "$OUT" = "ok" ]; then
    pass "§50 cd relatif masih mengenai file benar"
else
    fail "§50 cd relatif masih mengenai file benar" "out=$OUT"
fi

# §51a /proc/net/ EACCES di Termux (juga di host, bukan efek wadah). Shim dan
# supervisor Falling back ke snapshot di $BASE/usr/local/share/fakeroot/procnet
# supaya app musl yang pakai getifaddrs() tak gagal.
OUT=$(bash "$FR" --svsp sh -c 'head -c 1 /proc/net/if_inet6 >/dev/null 2>&1 && echo READABLE' 2>&1)
if [ "$OUT" = "READABLE" ]; then
    pass "§51a /proc/net/if_inet6 bisa dibaca (snapshot)"
else
    fail "§51a /proc/net/if_inet6 bisa dibaca (snapshot)" "out=$OUT"
fi

# §51b Node/libuv ambil interface lewat NETLINK_ROUTE yang Android blokir
# (EACCES). Preload fake-run harus membuat os.networkInterfaces() tidak melempar.
OUT=$(bash "$FR" --svsp sh -c 'node -e "const n=require(\"os\").networkInterfaces();console.log(Object.keys(n).length>0?\"NIF-OK\":\"NIF-KOSONG\")"' 2>&1)
if [ "$OUT" = "NIF-OK" ]; then
    pass "§51b node os.networkInterfaces() tidak melempar"
else
    fail "§51b node os.networkInterfaces() tidak melempar" "out=$(printf '%s' "$OUT" | tail -1)"
fi

# §53 shell WAJIB lewat supervisor. Shim LD_PRELOAD tak bisa menjangkau anak
# STATIS (probe Go, lefthook) yang di-spawn shell: syscall-nya mentah, path tak
# ter-rewrite, `newfstatat("/usr/bin/git")` jadi ENOENT padahal berkasnya ada.
# Gejala nyata: `npm ci` di repo Hermes memanggil `lefthook install` yang gagal
# LookPath "git: not found in $PATH". Bukti A/B: probe statis yang sama -> OK
# saat langsung / --svsp, ENOENT saat di-exec shell di jalur shim.
# WAJIB memakai anak STATIS: sh yang dynamic bisa di-shim, jadi test pakai
# `stat(1)` selalu hijau dan tak membuktikan apa pun. Probe kecil di-build:
# memanggil newfstatat(AT_FDCWD, "/etc/alpine-release") lewat syscall mentah —
# persis yang dilakukan runtime Go/Bun — lalu menulis hasilnya ke stdout.
ST53DIR="$BASE/tmp/.selftest-53"
if mkdir -p "$ST53DIR" 2>/dev/null &&
   cat > "$ST53DIR/p.c" <<'P53EOF'
#include <stdio.h>
#include <sys/syscall.h>
#include <fcntl.h>
#include <unistd.h>
struct s_st { unsigned long pad[18]; };
int main(void){ struct s_st s;
  long r = syscall(79 /*newfstatat*/, AT_FDCWD, "/etc/alpine-release", &s, 0);
  printf("%ld\n", r); return r < 0 ? 1 : 0; }
P53EOF
then
    _crt="$(clang -print-resource-dir 2>/dev/null)/lib/linux/libclang_rt.builtins-aarch64-android.a"
    clang --target=aarch64-alpine-linux-musl --sysroot="$BASE" -static -nostdlib -O2 -w \
        -o "$ST53DIR/p" "$BASE/usr/lib/crt1.o" "$BASE/usr/lib/crti.o" "$ST53DIR/p.c" \
        "$BASE/usr/lib/libc.a" "$BASE/usr/lib/crtn.o" "$_crt" 2>/dev/null
    if [ -x "$ST53DIR/p" ]; then
        OUT=$(bash "$FR" /bin/sh -c "'$ST53DIR/p'" 2>&1 | tr -d '\r' | tail -1)
        if [ "$OUT" = "0" ]; then
            pass "§53 shell via supervisor (anak statis tak kabur)"
        else
            fail "§53 shell via supervisor (anak statis tak kabur)" \
                 "newfstatat dari anak statis = '$OUT' (harusnya 0)"
        fi
        rm -rf "$ST53DIR" 2>/dev/null
    else
        info "§53 dilewati: gagal build probe statis"
    fi
else
    info "§53 dilewati: tak bisa buat direktori probe"
fi
if grep -qF 'sh|bash|dash|ash|ksh|zsh' "$SELF_DIR/fake-run"; then
    pass "§53 fake-run: shell dipaksa MODE=svsp"
else
    fail "§53 fake-run: shell dipaksa MODE=svsp" "daftar shell tak ada di fake-run"
fi

# §56 wrapper `ps`: pola `ps -p PID -o stat= -o lstart=` harus mengembalikan
# DUA baris rc=0 (codex daemon pid-management; pola sama dipakai Hermes
# update_lock sebagai fallback). busybox ps tak kenal lstart, GNU ps gagal
# btime (EACCES) — wrapper menghitung lstart dari /proc/PID/stat + anchor
# stabil. PID mati wajib tetap gagal (jangan pernah "mengarang hidup").
OUT=$(bash "$FR" sh -c 'ps -p $$ -o stat= -o lstart=' 2>&1); RC=$?
NL=$(printf '%s\n' "$OUT" | wc -l)
if [ "$RC" -eq 0 ] && [ "$NL" -eq 2 ]; then
    pass "§56 ps wrapper: -o stat/lstart dua baris"
else
    fail "§56 ps wrapper: -o stat/lstart dua baris" "rc=$RC baris=$NL out=$(printf '%s' "$OUT" | tail -1)"
fi
OUT=$(bash "$FR" sh -c 'A=$(ps -p $$ -o lstart=); B=$(ps -p $$ -o lstart=); [ "$A" = "$B" ] && echo STABIL' 2>&1)
if [ "$OUT" = "STABIL" ]; then
    pass "§56 ps wrapper: lstart stabil antar-baca"
else
    fail "§56 ps wrapper: lstart stabil antar-baca" "out=$OUT"
fi
OUT=$(bash "$FR" sh -c 'ps -p 999999 -o lstart= 2>/dev/null; echo rc=$?' 2>&1 | tail -1)
if [ "$OUT" = "rc=1" ]; then
    pass "§56 ps wrapper: PID mati tetap gagal"
else
    fail "§56 ps wrapper: PID mati tetap gagal" "out=$OUT"
fi

# §52 lsof GNU WAJIB: busybox lsof mengabaikan -t dan -i sehingga
# `lsof -ti:PORT` mengembalikan baris penuh, bukan PID. App yang parse
# kolom ke-2 (9router killProcessOnPort) lalu kill -9 <baris> → invalid,
# selalu gagal diam-diam (device 2026-10-09).
OUT=$(bash "$FR" sh -c 'lsof -ti:49374 2>/dev/null' 2>&1 | head -1)
case "$OUT" in
    "") pass "§52 lsof GNU: -ti:PORT mengembalikan kosong untuk port tak dipakai" ;;
    *"	"*) fail "§52 lsof GNU: -ti:PORT mengembalikan kosong untuk port tak dipakai" \
              "kolom BER-TAB terdeteksi → busybox lsof, bukan GNU: $OUT" ;;
    *)    fail "§52 lsof GNU: -ti:PORT mengembalikan kosong untuk port tak dipakai" \
              "mengembalikan isi tak terduga: $OUT" ;;
esac

# §49 node/npm ikut base_packages: tanpa itu fresh install tak punya npm sama
# sekali, jadi `npm install -g` yang tervalidasi di §47 tak bisa dipakai.
BS_SRC="$SELF_DIR/bootstrap.sh"
if [ -f "$BS_SRC" ]; then
    if grep -q 'nodejs npm' "$BS_SRC"; then
        pass "§49 bootstrap: nodejs+npm ikut base_packages"
    else
        fail "§49 bootstrap: nodejs+npm ikut base_packages" "nodejs/npm tak ada di base_packages"
    fi
else
    info "§49 dilewati: bootstrap.sh tak ditemukan di $SELF_DIR"
fi

# --- 9. pembersihan ----------------------------------------------------------
info "cleanup: purge $PKG ..."
bash "$FR" apk del --no-scripts "$PKG" >/dev/null 2>&1
if bash "$DOC" --base="$BASE" >/dev/null 2>&1; then
    pass "akhir: DB tetap bersih"
else
    info "akhir: ada flag f/s baru tertulis selama test — dibersihkan:"
    bash "$DOC" --base="$BASE" --clear-broken >/dev/null 2>&1
fi
rm -f "$TMPF"

echo "== RINGKASAN: $FAILS FAIL =="
exit "$FAILS"
