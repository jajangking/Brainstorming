#!/data/data/com.termux/files/usr/bin/bash
#
# apps — launcher TUI untuk aplikasi di dalam wadah Alpine.
#
#   apps              # buka launcher (mode TTY)
#   apps --list       # daftar plainly (tanpa TTY, untuk log/CI)
#   apps <nama>       # jalankan aplikasi langsung (tanpa UI)
#   apps --refresh    # pindai ulang (dipakai setelah pasang app baru)
#
# Kontrol: ← ↑ → ⇄ pindah   Enter jalankan   r pindai ulang   q keluar
#          / atau ketik     filter cepat
#
# Aplikasi terdaftar di apps.list (format: NAMA|IKON|TAGLINE|PATH_DETEK|CMD).
# Kolom path berawalan "B:" = relatif ke base wadah. Yang tidak terdeteksi
# ditampilkan redup dengan status "belum terpasang" dan tak bisa dipilih.

set -uo pipefail

: "${PREFIX:=/data/data/com.termux/files/usr}"
: "${HOME:=/data/data/com.termux/files/home}"
SELF="$(cd "$(dirname "$0")" && pwd)"
BASE="${FAKE_BASE:-$HOME/alpine-rootfs}"
FR="$SELF/fake-run"; [ -x "$FR" ] || FR="$PREFIX/bin/fake-run"
LIST="$SELF/apps.list"; [ -f "$LIST" ] || LIST="$PREFIX/share/brainstorming/apps.list"

G=$'\033[1;38;2;0;255;0m'   # bright green
GS=$'\033[38;2;0;170;0m'   # solid green
O=$'\033[38;2;255;135;0m'   # orange
D=$'\033[2;38;2;0;170;0m'   # dim green
R=$'\033[7;38;2;0;255;0m'   # reverse (terpilih)
N=$'\033[0m'

# ------------------------------------------------------------------ registry
declare -a NAME ICON TAG PATH_ CMD_
load_list() {
    NAME=(); ICON=(); TAG=(); PATH_=(); CMD_=()
    [ -f "$LIST" ] || { echo "apps: apps.list tak ditemukan: $LIST" >&2; return 1; }
    local line nf ic tg pt cmd
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        IFS='|' read -r nf ic tg pt cmd <<< "$line"
        #trim setiap field lebih dulu — tanpa ini " B:bin/sh " tak cocok
        #pola 'B:*' dan semua app terbaca "belum terpasang".
        nf=${nf#"${nf%%[![:space:]]*}"}; nf=${nf%"${nf##*[![:space:]]}"}
        ic=${ic#"${ic%%[![:space:]]*}"}; ic=${ic%"${ic##*[![:space:]]}"}
        tg=${tg#"${tg%%[![:space:]]*}"}; tg=${tg%"${tg##*[![:space:]]}"}
        pt=${pt#"${pt%%[![:space:]]*}"}; pt=${pt%"${pt##*[![:space:]]}"}
        cmd=${cmd#"${cmd%%[![:space:]]*}"}; cmd=${cmd%"${cmd##*[![:space:]]}"}
        [ -n "${nf:-}" ] || continue
        NAME+=("$nf"); ICON+=("$ic"); TAG+=("$tg"); PATH_+=("$pt"); CMD_+=("$cmd")
    done < "$LIST"
}

# TRUE bila path ada di host; "B:xxx" -> dicek di dalam base
is_installed() {
    local p="$1"
    case "$p" in
        B:*) [ -e "$BASE/${p#B:}" ] ;;
        *)   [ -e "$p" ] || [ -e "$BASE/$p" ] ;;
    esac
}

installed_idx() { # -> index dalam array NAME, atau -1
    local i
    for i in "${!NAME[@]}"; do is_installed "${PATH_[$i]}" && { echo "$i"; return; }; done
    echo -1
}

named_idx() { # <nama> -> index (case-insensitive), atau -1
    local want=$1 i
    for i in "${!NAME[@]}"; do
        [ "${NAME[$i]}" = "$want" ] && { echo "$i"; return; }
    done
    echo -1
}

# ------------------------------------------------------------------ jalankan
run_app() { # run_app <index>
    local idx=$1
    is_installed "${PATH_[$idx]}" || { echo "apps: ${NAME[$idx]} belum terpasang" >&2; return 1; }
    printf '\033[?25h\033[?1049l' 2>/dev/null || true
    local dir; dir="$(pwd)"
    case "${CMD_[$idx]}" in
        *apk*|*sh\ -c*|*sh\ -lc*) : ;;                       # bisa di host
        *) [ -d "$BASE" ] && cd "$BASE/root" 2>/dev/null || cd "$dir" ;;
    esac
    eval "${CMD_[$idx]}"
}

# ------------------------------------------------------------------ mode list
do_list() {
    load_list || exit 2
    printf '%sAplikasi di wadah (%s)%s\n\n' "$G" "$BASE" "$N"
    printf '  %-3s %-4s %-10s %s\n' "#" "IKON" "NAMA" "STATUS"
    local i st
    for i in "${!NAME[@]}"; do
        if is_installed "${PATH_[$i]}"; then st="${G}terpasang${N}"
        else st="${D}belum terpasang${N}"; fi
        printf '  %-3s %-4s %-10s %s  %s\n' "$((i+1))" "${ICON[$i]}" "${NAME[$i]}" "$st" "${TAG[$i]}"
    done
    echo
}

# ------------------------------------------------------------------ mode TUI
draw() {
    local cols rows cells cwid ncol sel=$1 filter=${2:-} selname
    cols=$(tput cols 2>/dev/null || echo 80); [ "$cols" -gt 20 ] 2>/dev/null || cols=80
    rows=$(tput lines 2>/dev/null || echo 24); [ "$rows" -gt 10 ] 2>/dev/null || rows=24
    cwid=18; ncol=$(( cols / cwid )); [ "$ncol" -lt 1 ] && ncol=1
    printf '\033[H\033[2J'
    printf '%s  apps%s  %s— launcher aplikasi di dalam wadah%s\n' "$G" "$N" "$D" "$N"
    local -a vis=(); local i
    local up; up=$(printf '%s' "$filter" | tr '[:lower:]' '[:upper:]')
    for i in "${!NAME[@]}"; do
        if [ -n "$filter" ]; then
            # case-insensitive: nama/deskripsi di-upper-kan, filter juga
            local nu tu; nu=$(printf '%s' "${NAME[$i]}" | tr '[:lower:]' '[:upper:]')
            tu=$(printf '%s' "${TAG[$i]}" | tr '[:lower:]' '[:upper:]')
            case "$nu$tu" in *"$up"*) : ;; *) continue ;; esac
        fi
        vis+=("$i")
    done
    [ ${#vis[@]} -eq 0 ] && { printf '\n  %stidak ada app cocok dengan "%s"%s\n' "$O" "$filter" "$N"; return; }
    # headline
    printf '\n'
    local k=0
    for i in "${!vis[@]}"; do
        local idx=${vis[$i]} inst
        if is_installed "${PATH_[$idx]}"; then inst=1; else inst=0; fi
        local cell="${ICON[$idx]} ${NAME[$idx]}"
        if [ $((k % ncol)) -eq 0 ]; then printf '  '; fi
        if [ $inst -eq 0 ]; then printf '%s%*s%s' "$D" "$cwid" "$cell"
        elif [ "$i" = "$sel" ]; then printf '%s%*s%s' "$R" "$cwid" "$cell"
        else printf '%s%*s%s' "$G" "$cwid" "$cell"; fi
        printf '%s' "$N"
        k=$((k+1))
        if [ $((k % ncol)) -eq 0 ]; then printf '\n'; fi
    done
    [ $((k % ncol)) -ne 0 ] && printf '\n'
    # detail baris terpilih
    local ti=${vis[$sel]:-${vis[0]}}
    local inst; is_installed "${PATH_[$ti]}" && inst="${G}● terpasang${N}" || inst="${D}○ belum terpasang (pasang manual di dalam wadah)${N}"
    printf '\n  %s%s %s%s  %s— %s%s\n' "$G" "${ICON[$ti]}" "$N" "${NAME[$ti]}" "$D" "${TAG[$ti]}" "$N"
    printf '  %s\n' "$inst"
    # hint baris bawah
    printf '\n  %s↑ ↓ ← → pilih%s   %sEnter%s jalan   %sTab%s berikutnya   %sr%s pindai   %sq%s keluar\n' \
        "$D" "$N" "$O" "$N" "$O" "$N" "$O" "$N" "$O" "$N"
}

tui() {
    load_list || exit 2
    trap 'printf "\033[?25h\033[?1049l" 2>/dev/null' EXIT INT TERM
    printf '\033[?1049h\033[?25l\033[2J\033[H'
    local sel=0 filter='' key esc selname
    while :; do
        draw "$sel" "$filter"
        IFS= read -rsn1 -t 0.5 key 2>/dev/null || key=''
        # baca sisa escape sequence (arrow/tab)
        if [ "$key" = $'\033' ]; then
            IFS= read -rsn2 -t 0.1 esc 2>/dev/null || esc=''
            case "$esc" in
                '[A') sel=$(( sel - 1 )); [ $sel -lt 0 ] && sel=0 ;;
                '[B') sel=$(( sel + 1 )) ;;
                '[C') : ;;
                '[D') : ;;
                '[5~') sel=0 ;;
                '[6~') sel=$(( sel + 1 )) ;;
            esac
            continue
        fi
        case "$key" in
            '')          : ;;                      # timeout, redraw
            q|Q|$'\003') break ;;                 # keluar
            r|R)         sel=0 ;;
            $'\t')       sel=$(( sel + 1 )) ;;    # tab = next
            $'\n'|$'\r') run_app "$(current_idx "$sel" "$filter")" && break || true ;;
            $'\177'|$'\b') [ -n "$filter" ] && filter="${filter%?}" ;;
            *)           [ ${#filter} -lt 16 ] && filter="$filter$key" && sel=0 ;;
        esac
    done
    printf '\033[?25h\033[?1049l'
}

# index absolut dari posisi visual ke-n dalam daftar terfilter
current_idx() { # <sel> <filter>
    local sel=$1 filter=${2:-} k=0 i
    local up; up=$(printf '%s' "$filter" | tr '[:lower:]' '[:upper:]')
    for i in "${!NAME[@]}"; do
        if [ -n "$filter" ]; then
            local nu tu; nu=$(printf '%s' "${NAME[$i]}" | tr '[:lower:]' '[:upper:]')
            tu=$(printf '%s' "${TAG[$i]}" | tr '[:lower:]' '[:upper:]')
            case "$nu$tu" in *"$up"*) : ;; *) continue ;; esac
        fi
        [ $k -eq "$sel" ] && { echo "$i"; return; }
        k=$((k+1))
    done
    echo -1
}

# ------------------------------------------------------------------ CLI
case "${1:-}" in
    --list|-l) do_list; exit 0 ;;
    --refresh) do_list; exit 0 ;;
    --help|-h)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "")
        if [ -t 0 ] && [ -t 1 ]; then tui; else do_list; fi ;;
    *)
        load_list || exit 2
        load_list || exit 2
        i=$(named_idx "$1")
        [ "$i" -ge 0 ] 2>/dev/null || { echo "apps: tidak dikenal: $1" >&2; do_list; exit 2; }
        is_installed "${PATH_[$i]}" || { echo "apps: ${NAME[$i]} belum terpasang di $BASE" >&2; exit 3; }
        run_app "$i" ;;
esac