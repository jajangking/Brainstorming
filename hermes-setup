#!/bin/sh
# Instalasi/penyelesaian Hermes Agent sampai BENAR-BENAR complete di wadah.
#
# LATAR: installer/updater Hermes gagal di 4 titik berbeda di Android
# (terdokumentasi di HANDOFF §41.4c-§41.4h, §54-§55):
#   1. `npm ci` -> `lefthook install` (Go statis, faccessat2 diblokir kernel
#      -> SIGSYS). Workaround: sembunyikan .git (loophole upstream a50c4ba7c9).
#   2. `web.mjs` resmi (typecheck+vite satu proses) -> SIGSEGV. Workaround:
#      build tahap terpisah (hermes-web-build).
#   3. Self-lock `hermes update`: completion child ditolak parent-nya sendiri.
#      Workaround: jalankan tail langsung tanpa kontender (terbukti hijau).
#   4. Lock teks basi (.git/hermes-update.lock) menunjuk PID mati. Workaround:
#      buang HANYA bila flock bebas + tak ada proses Hermes + PID mati.
#
# Skrip ini merangkai semuanya + retry terbatas. Idempoten: aman dijalankan
# ulang kapan pun. TIDAK menyentuh file milik Hermes (tak ada patch tree).
#
# Pakai:  hermes-setup              (host Termux)

set -u
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
FAKE_RUN="$PREFIX/bin/fake-run"
BASE="${FAKE_BASE:-$HOME/alpine-rootfs}"
HERMES="$BASE/root/.hermes/hermes-agent"
MAX_ROUNDS=3
TAILLOG="$BASE/tmp/hermes-setup-tail.log"

die() { printf '\033[1;31m[x] %s\033[0m\n' "$*" >&2; exit 1; }
log() { printf '\033[1;32m[+] %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m[!] %s\033[0m\n' "$*"; }

[ -x "$FAKE_RUN" ] || die "fake-run tak ada"
[ -d "$HERMES" ] || die "repo Hermes tak ada ($HERMES) — jalankan installer Hermes dulu"
command -v hermes-reinstall >/dev/null 2>&1 || die "hermes-reinstall tak ada (update repo Brainstorming?)"
command -v hermes-web-build >/dev/null 2>&1 || die "hermes-web-build tak ada (update repo Brainstorming?)"

# Jalankan perintah DI DALAM wadah.
in_wadah() { # in_wadah <sh-script>
    env -u LD_PRELOAD "$FAKE_RUN" --svsp --base="$BASE" /bin/sh -c "$1"
}

# Lock basi boleh dibuang HANYA bila: tak ada proses Hermes + PID di dalamnya
# mati. Selain itu JANGAN (bisa merusak update yang jalan).
clear_stale_lock() {
    LOCK="$HERMES/.git/hermes-update.lock"
    [ -f "$LOCK" ] || return 0
    if pgrep -f 'hermes update|source_completion|update_completion|npm ci|vite|tsc|esbuild' 2>/dev/null | grep -vx "$$" | grep -q .; then
        warn "proses Hermes masih jalan — lock dibiarkan"
        return 0
    fi
    PID="$(head -1 "$LOCK" 2>/dev/null | grep -oE '^[0-9]+' || true)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        warn "lock milik PID hidup ($PID) — dibiarkan"
        return 0
    fi
    rm -f "$LOCK" && log "lock teks basi dibuang"
}

ROUND=1
while [ "$ROUND" -le "$MAX_ROUNDS" ]; do
    log "=== ronde $ROUND/$MAX_ROUNDS ==="
    clear_stale_lock

    log "[1/5] hermes update (tarik commit terbaru)..."
    in_wadah 'export PATH=$PATH:/root/.hermes/hermes-agent/.hermes/bin; hermes update 2>&1 | tail -5'

    log "[2/5] node deps (hermes-reinstall)..."
    hermes-reinstall >/dev/null 2>&1 || warn "hermes-reinstall rc!=0"

    log "[3/5] web dist (hermes-web-build, tahap terpisah)..."
    hermes-web-build >/dev/null 2>&1 || warn "hermes-web-build rc!=0"

    log "[4/5] TUI (tui.mjs resmi)..."
    in_wadah 'HROOT=/root/.hermes; ND=$(ls -d $HROOT/tools/node-*/bin | head -1); cd $HROOT/hermes-agent && export NODE_OPTIONS="$NODE_OPTIONS --max-old-space-size=6144" && "$ND/node" scripts/build/tui.mjs 2>&1 | tail -2'

    log "[5/5] tail completion langsung (tanpa kontender lock)..."
    in_wadah 'V=$(ls -d /root/.hermes/installs/*/environments/*/venv/bin/python 2>/dev/null | head -1); [ -x "$V" ] || exit 1; cat > /tmp/hermes-tail-run.py <<PYEOF
import os, sys
sys.path.insert(0, "/root/.hermes/hermes-agent")
from pathlib import Path
from pm.environments import activation_environment
env = dict(activation_environment(Path("/root/.hermes/hermes-agent")))
argv = [sys.executable, "-I", "-B", "-u",
    "/root/.hermes/hermes-agent/hermes_cli/source_completion.py",
    "--source", "/root/.hermes/hermes-agent", "--finish-update", "--prepared"]
os.execvpe(sys.executable, argv, env)
PYEOF
cd /root/.hermes/hermes-agent && "$V" /tmp/hermes-tail-run.py' > "$TAILLOG" 2>&1
    sed 's/\x1b\[[0-9;]*m//g' "$TAILLOG" | tail -14

    if grep -q "did not finish" "$TAILLOG"; then
        warn "tail masih ada follow-up gagal — retry ($ROUND/$MAX_ROUNDS)"
        ROUND=$((ROUND + 1))
        continue
    fi
    if grep -q "Update complete!" "$TAILLOG"; then
        log "SELESAI: tail complete tanpa follow-up gagal."
        in_wadah 'export PATH=$PATH:/root/.hermes/hermes-agent/.hermes/bin; hermes --version 2>&1 | head -2'
        rm -f "$BASE/tmp/hermes-tail-run.py"
        exit 0
    fi
    warn "tail tak menulis 'Update complete!' — retry ($ROUND/$MAX_ROUNDS)"
    ROUND=$((ROUND + 1))
done

die "belum complete setelah $MAX_ROUNDS ronde. Lihat $TAILLOG."
