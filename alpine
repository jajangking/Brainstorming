#!/data/data/com.termux/files/usr/bin/bash
#
# alpine — Masuk shell Alpine di wadah palsu (pengganti proot-distro login alpine)
#
# Pakai:
#   alpine                    # masuk shell interaktif
#   alpine -c "command"       # jalankan command
#   alpine apk add vim        # jalankan apk langsung
#
# Sama kayak `proot-distro login alpine`, tapi native speed.

set -euo pipefail

BASE="${FAKE_BASE:-$HOME/alpine-rootfs}"
FR="${FAKE_RUN:-$PREFIX/bin/fake-run}"

# Cek wadah ada
if [ ! -d "$BASE" ]; then
    echo "Wadah Alpine belum ada. Install dulu:"
    echo "  cd ~/Brainstorming && ./install.sh"
    exit 1
fi

# Cek fake-run ada
if [ ! -x "$FR" ]; then
    echo "fake-run tidak ada. Install dulu:"
    echo "  cd ~/Brainstorming && ./install.sh"
    exit 1
fi

# Default port opencode wadah (lihat bootstrap.sh §32): opencode wadah DAN
# opencode host sama-sama default ke port service 49374 -> bentrok bila
# keduanya jalan. setup_opencode_port di bootstrap hanya kepicu bila opencode
# SUDAH ada saat bootstrap; opencode yang dipasang belakangan (kasus umum
# pasca-install-fresh, temuan device 2026-10-08) lolos dari sana. Maka
# pastikan di sini, tiap kali masuk wadah. Idempoten: hanya DIBUAT bila
# opencode ada tapi config belum ada (tak pernah menimpa pilihan user).
if [ -x "$BASE/root/.opencode/bin/opencode" ] && [ ! -e "$BASE/root/.config/opencode/service.json" ]; then
    mkdir -p "$BASE/root/.config/opencode" 2>/dev/null || true
    printf '{ "port": 49474 }\n' > "$BASE/root/.config/opencode/service.json" 2>/dev/null || true
fi

# Masuk shell atau jalankan command
if [ $# -eq 0 ]; then
    # Shell interaktif. Mendarat di /root wadah (= $HOME) supaya prompt
    # pendek: \w => "~" (bukan path penuh /data/data/.../alpine-rootfs).
    [ -d "$BASE/root" ] || mkdir -p "$BASE/root"
    echo "Masuk Alpine 3.24.2 (fake-chroot, native speed)"
    echo "Ketik 'exit' untuk keluar"
    echo
    exec env -u LD_PRELOAD FAKE_START="$BASE/root" "$FR" --base="$BASE" /bin/sh -l
elif [ "$1" = "-c" ]; then
    # alpine -c "command" — jalankan command string di dalam wadah
    shift
    exec env -u LD_PRELOAD "$FR" --base="$BASE" /bin/sh -c "$*"
else
    # alpine <program> [args...] — program di-resolve via PATH wadah (fake-run)
    exec env -u LD_PRELOAD "$FR" --base="$BASE" "$@"
fi